# =========================================================================
# .env.example — Variables d'environnement (CÔTÉ SERVEUR)
# -------------------------------------------------------------------------
# Copiez ce fichier en ".env" et renseignez vos vraies valeurs.
# NE COMMITTEZ JAMAIS le fichier .env (ajoutez-le au .gitignore).
# Ces variables sont utilisées par les fonctions serverless
# (Netlify Functions / Vercel Functions) : création de session Stripe
# Checkout, réception du webhook, envoi de l'email de livraison.
# =========================================================================

# ---- Stripe ----
# Clé SECRÈTE (Dashboard Stripe > Développeurs > Clés API). Ne jamais exposer côté client.
STRIPE_SECRET_KEY=<votre_cle_secrete_stripe>
# Clé PUBLIQUE (peut aussi vivre dans config.js côté front)
STRIPE_PUBLIC_KEY=<votre_cle_publique_stripe>
# Secret de signature du webhook (Dashboard > Webhooks > votre endpoint)
STRIPE_WEBHOOK_SECRET=<votre_secret_webhook_stripe>

# ---- PayPal ----
PAYPAL_CLIENT_ID=<votre_client_id_paypal>
PAYPAL_SECRET=<votre_secret_paypal>
# Environnement PayPal : "sandbox" (tests) ou "live" (production)
PAYPAL_ENV=live

# ---- Envoi des emails de livraison (au choix de votre fournisseur) ----
# Adresse expéditrice affichée dans l'email de livraison des PDF
SENDER_EMAIL=aminemekhfi45@gmail.com
SENDER_NAME=MK Phone — Éditions Techniques
# Clé API de votre service d'emailing transactionnel (ex. Resend, SendGrid, Mailgun)
EMAIL_API_KEY=<votre_cle_api_email>

# ---- Livraison des fichiers PDF ----
# URLs de téléchargement sécurisées / signées (générées à la commande)
DOWNLOAD_URL_REPARATION=https://votre-stockage/securise/guide-reparation.pdf
DOWNLOAD_URL_FLASH=https://votre-stockage/securise/flash-decodage.pdf
# Durée de validité (en heures) des liens de téléchargement signés
DOWNLOAD_LINK_TTL=72

# ---- Divers ----
# URL publique du site (pour les redirections success/cancel)
SITE_URL=https://votre-domaine.fr
